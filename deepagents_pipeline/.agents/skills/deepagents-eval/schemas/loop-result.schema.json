{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://active-suggestion.local/schemas/deepagents-loop-result.schema.json",
  "title": "Deepagents unified evaluation result",
  "description": "Schema for one JSONL record emitted by deepagents_pipeline.runner.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "idx",
    "requestIdx",
    "passed",
    "terminal_cause",
    "model_turns",
    "input_tokens",
    "output_tokens",
    "elapsed_sec",
    "response",
    "trace",
    "timeline"
  ],
  "properties": {
    "idx": {
      "type": "integer",
      "minimum": 0
    },
    "requestIdx": {
      "type": [
        "integer",
        "null"
      ]
    },
    "passed": {
      "type": "boolean"
    },
    "terminal_cause": {
      "type": ["string", "null"],
      "enum": [
        "pass",
        "budget_exhausted",
        "edit_exhausted",
        "wall_clock",
        "recursion_limit",
        "agent_stop",
        "connection_error",
        "internal_error",
        "protocol_error",
        "unsupported_input",
        null
      ]
    },
    "model_turns": {
      "type": "integer",
      "minimum": 0
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "elapsed_sec": {
      "type": "number",
      "minimum": 0
    },
    "response": {
      "oneOf": [
        {
          "$ref": "#/$defs/successResponse"
        },
        {
          "$ref": "#/$defs/errorResponse"
        }
      ]
    },
    "trace": {
      "oneOf": [
        {
          "$ref": "#/$defs/trace"
        },
        {
          "type": "null"
        }
      ]
    },
    "timeline": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/modelTurnEvent"
          },
          {
            "$ref": "#/$defs/toolResultEvent"
          }
        ]
      }
    }
  },
  "$defs": {
    "codeModification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "startLine"
      ],
      "properties": {
        "type": {
          "enum": [
            "add",
            "delete"
          ]
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "content": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explore_elapsed_time",
        "fix_elapsed_time",
        "select_elapsed_time",
        "graph_elapsed_time"
      ],
      "properties": {
        "explore_elapsed_time": {
          "type": "number",
          "minimum": 0
        },
        "fix_elapsed_time": {
          "type": "number",
          "minimum": 0
        },
        "select_elapsed_time": {
          "type": "number",
          "minimum": 0
        },
        "graph_elapsed_time": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "successResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isSuccess",
        "userId",
        "moduleKind",
        "requestIdx",
        "desc",
        "codeModifications",
        "timings"
      ],
      "properties": {
        "isSuccess": {
          "const": true
        },
        "userId": {
          "type": "integer"
        },
        "moduleKind": {
          "const": "ActiveSuggestion"
        },
        "requestIdx": {
          "type": "integer"
        },
        "desc": {
          "type": "string"
        },
        "codeModifications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/codeModification"
          }
        },
        "timings": {
          "$ref": "#/$defs/timings"
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isSuccess",
        "userId",
        "moduleKind",
        "requestIdx",
        "desc",
        "codeModifications",
        "timings",
        "errorCode",
        "errorStage",
        "errorNode",
        "errorType",
        "errorMessage"
      ],
      "properties": {
        "isSuccess": {
          "const": false
        },
        "userId": {
          "type": [
            "integer",
            "null"
          ]
        },
        "moduleKind": {
          "const": "ActiveSuggestion"
        },
        "requestIdx": {
          "type": [
            "integer",
            "null"
          ]
        },
        "desc": {
          "type": "string"
        },
        "codeModifications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/codeModification"
          }
        },
        "timings": {
          "$ref": "#/$defs/timings"
        },
        "errorCode": {
          "type": "string"
        },
        "errorStage": {
          "type": "string"
        },
        "errorNode": {
          "type": "string"
        },
        "errorType": {
          "type": "string"
        },
        "errorMessage": {
          "type": "string"
        }
      }
    },
    "verifierError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "stage",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "passed",
        "errors"
      ],
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "passed": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verifierError"
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "desc",
        "codeModifications",
        "multi_site"
      ],
      "properties": {
        "desc": {
          "type": "string"
        },
        "codeModifications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/codeModification"
          }
        },
        "multi_site": {
          "type": "boolean"
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_cause",
        "attempts",
        "candidates",
        "model_turns",
        "input_tokens",
        "output_tokens",
        "edit_calls",
        "edit_errors",
        "edit_failure_kinds",
        "roundtrip_failures",
        "fuzzy_matches",
        "fuzzy_kinds",
        "reindented_edits",
        "nudges",
        "fix_elapsed_sec",
        "graph_elapsed_sec"
      ],
      "properties": {
        "terminal_cause": {
          "enum": [
            "pass",
            "budget_exhausted",
            "edit_exhausted",
            "wall_clock",
            "recursion_limit",
            "agent_stop",
            "connection_error",
            "internal_error",
            "protocol_error",
            "unsupported_input"
          ]
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attempt"
          }
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "model_turns": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "edit_calls": {
          "type": "integer",
          "minimum": 0
        },
        "edit_errors": {
          "type": "integer",
          "minimum": 0
        },
        "edit_failure_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "roundtrip_failures": {
          "type": "integer",
          "minimum": 0
        },
        "fuzzy_matches": {
          "type": "integer",
          "minimum": 0
        },
        "fuzzy_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reindented_edits": {
          "type": "integer",
          "minimum": 0
        },
        "nudges": {
          "type": "integer",
          "minimum": 0
        },
        "fix_elapsed_sec": {
          "type": "number",
          "minimum": 0
        },
        "graph_elapsed_sec": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "toolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "args_brief"
      ],
      "properties": {
        "tool": {
          "type": "string"
        },
        "args_brief": {
          "type": "string"
        }
      }
    },
    "modelTurnEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ev",
        "turn",
        "tool_calls",
        "text_head"
      ],
      "properties": {
        "ev": {
          "const": "model_turn"
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolCall"
          }
        },
        "text_head": {
          "type": "string"
        }
      }
    },
    "toolResultEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ev",
        "tool",
        "result_head",
        "result_lines"
      ],
      "properties": {
        "ev": {
          "const": "tool_result"
        },
        "tool": {
          "type": "string"
        },
        "result_head": {
          "type": "string"
        },
        "result_lines": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
