# Whitelist mode: ignore everything, then re-include tracked paths only
/*
!/.gitignore
!/README.md
!/pyproject.toml
!/uv.lock
!/.python-version
!/build.py
!/src/
/src/*
!/src/agents/
!/src/astchunk/

# Generated build artifacts (never track, anywhere)
src/astchunk/build/
*.egg-info/
.omc/
__pycache__/
*.pyc
*.pyo
.env
.env.*
